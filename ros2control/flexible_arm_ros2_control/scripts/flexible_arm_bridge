#!/usr/bin/env python3
"""Bridge ros2_control JointState topics to the FlexibleArm Python SDK."""

import math

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import JointState

from flexible_arm import FlexibleArm
from flexible_arm.config import load_joint_config


class FlexibleArmBridge(Node):
    def __init__(self) -> None:
        super().__init__("flexible_arm_bridge")
        self.declare_parameter("port", "/dev/ttyUSB0")
        self.declare_parameter("baudrate", 115200)
        self.declare_parameter("config_file", "arm_config.json")
        self.declare_parameter("command_duration", 0.1)
        self.declare_parameter("state_rate", 20.0)
        self.declare_parameter("state_limit_tolerance_deg", 1.0)
        self.declare_parameter(
            "ros_joint_names", ["base", "shoulder", "elbow"]
        )
        self.declare_parameter(
            "sdk_joint_names", ["base", "shoulder", "elbow"]
        )

        config_file = self.get_parameter("config_file").value
        joints = load_joint_config(config_file)
        self.arm = FlexibleArm(joints)
        self.joints_by_name = {joint.name: joint for joint in joints}
        self.arm.connect(
            self.get_parameter("port").value,
            self.get_parameter("baudrate").value,
        )
        self.ros_joint_names = list(
            self.get_parameter("ros_joint_names").value
        )
        sdk_joint_names = list(
            self.get_parameter("sdk_joint_names").value
        )
        if len(self.ros_joint_names) != len(sdk_joint_names):
            raise RuntimeError(
                "ros_joint_names and sdk_joint_names must have equal lengths"
            )
        configured_names = {joint.name for joint in joints}
        missing_names = set(sdk_joint_names) - configured_names
        if missing_names:
            raise RuntimeError(
                f"SDK config is missing joints: {sorted(missing_names)}"
            )
        self.ros_to_sdk = dict(zip(self.ros_joint_names, sdk_joint_names))
        self.sdk_to_ros = {
            sdk_name: ros_name
            for ros_name, sdk_name in self.ros_to_sdk.items()
        }
        self.command_duration = float(
            self.get_parameter("command_duration").value
        )
        self.state_limit_tolerance_deg = float(
            self.get_parameter("state_limit_tolerance_deg").value
        )
        self.clamp_warnings = set()

        self.command_subscription = self.create_subscription(
            JointState,
            "/flexible_arm/commands",
            self.command_callback,
            10,
        )
        self.state_publisher = self.create_publisher(
            JointState, "/flexible_arm/states", 10
        )
        state_rate = float(self.get_parameter("state_rate").value)
        self.state_timer = self.create_timer(1.0 / state_rate, self.publish_state)
        self.get_logger().info(
            f"Connected to {self.get_parameter('port').value}; "
            f"joint mapping={self.ros_to_sdk}"
        )

    def command_callback(self, message: JointState) -> None:
        positions = dict(zip(message.name, message.position))
        targets = {
            sdk_name: math.degrees(positions[ros_name])
            for ros_name, sdk_name in self.ros_to_sdk.items()
            if ros_name in positions
        }
        if not targets:
            return
        try:
            self.arm.move_joints(targets, duration=self.command_duration)
        except Exception as exc:
            self.get_logger().error(f"Failed to command arm: {exc}")

    def publish_state(self) -> None:
        try:
            state = self.arm.get_state()
        except Exception as exc:
            self.get_logger().error(f"Failed to read arm state: {exc}")
            return

        message = JointState()
        message.header.stamp = self.get_clock().now().to_msg()
        for joint in state.joints:
            if (
                joint.position_deg is not None
                and joint.name in self.sdk_to_ros
            ):
                position_deg = joint.position_deg
                config = self.joints_by_name[joint.name]
                if (
                    config.min_deg - self.state_limit_tolerance_deg
                    <= position_deg
                    < config.min_deg
                ):
                    position_deg = config.min_deg
                    self._warn_clamped_state(joint.name, joint.position_deg)
                elif (
                    config.max_deg
                    < position_deg
                    <= config.max_deg + self.state_limit_tolerance_deg
                ):
                    position_deg = config.max_deg
                    self._warn_clamped_state(joint.name, joint.position_deg)

                message.name.append(self.sdk_to_ros[joint.name])
                message.position.append(math.radians(position_deg))
        self.state_publisher.publish(message)

    def _warn_clamped_state(self, joint_name: str, measured_deg: float) -> None:
        if joint_name in self.clamp_warnings:
            return
        self.clamp_warnings.add(joint_name)
        self.get_logger().warning(
            f"{joint_name} measured {measured_deg:.3f}°, clamped to its "
            "configured limit because it is within "
            f"{self.state_limit_tolerance_deg:.3f}° tolerance"
        )

    def destroy_node(self) -> bool:
        self.arm.disconnect()
        return super().destroy_node()


def main() -> None:
    rclpy.init()
    node = FlexibleArmBridge()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
