<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="flexible_arm">
  <xacro:arg name="command_topic" default="/flexible_arm/commands"/>
  <xacro:arg name="state_topic" default="/flexible_arm/states"/>

  <link name="base_link"/>
  <link name="link_1"/>
  <link name="link_2"/>
  <link name="link_3"/>

  <joint name="base" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="3.141592654" effort="10.0" velocity="2.0"/>
  </joint>

  <joint name="shoulder" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.221730476" upper="1.919862177" effort="10.0" velocity="2.0"/>
  </joint>

  <joint name="elbow" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.2 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.094395102" upper="2.094395102" effort="10.0" velocity="2.0"/>
  </joint>

  <ros2_control name="FlexibleArmSystem" type="system">
    <hardware>
      <plugin>flexible_arm_ros2_control/TopicSystem</plugin>
      <param name="command_topic">$(arg command_topic)</param>
      <param name="state_topic">$(arg state_topic)</param>
      <param name="command_threshold">0.0001</param>
    </hardware>
    <joint name="base">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">3.141592654</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="shoulder">
      <command_interface name="position">
        <param name="min">-1.221730476</param>
        <param name="max">1.919862177</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="elbow">
      <command_interface name="position">
        <param name="min">-2.094395102</param>
        <param name="max">2.094395102</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </ros2_control>
</robot>
